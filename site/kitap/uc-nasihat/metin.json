8.78,"s":1030.24},{"t":"Onu bir zalim herif aldı, zavallı tazeye dünyayı zindan etti.","b":1030.59,"s":1034.68},{"t":"Dört senedir işte, köyüne yeni geliyor...","b":1035.03,"s":1037.42}],[{"t":"— Acayip...","b":1038.22,"s":1038.92}],[{"t":"— Evet, bütün köylü zorladı da, bu sefer izin alabildi.","b":1039.72,"s":1043.28},{"t":"Kocası öyle fena, zalim bir adam ki...","b":1043.63,"s":1046.14}],[{"t":"Durmuş'un yüreği atmaya başladı.","b":1046.94,"s":1049.13},{"t":"Karısının nerede yatacağını sordu.","b":1049.48,"s":1051.7},{"t":"Kocakarı:","b":1052.05,"s":1052.91}],[{"t":"— Bilmem, diye cevap verdi.","b":1053.71,"s":1055.38}],[{"t":"Durmuş düşündü, taşındı, birdenbire dedi ki:","b":1056.18,"s":1059.34}],[{"t":"— Beni bu gece bu kadınla yatırabilir sen, sana beş altın veririm.","b":1060.14,"s":1063.77}],[{"t":"— Yiğidim ondan kolay ne var?","b":1064.57,"s":1066.38}],[{"t":"— Demek beni onunla yatırabileceksin?","b":1067.18,"s":1069.36}],[{"t":"— Elbet.","b":1070.16,"s":1070.89}],[{"t":"— Nasıl?","b":1071.69,"s":1072.44}],[{"t":"— Onun akrabaları benim kapı bir komşumdur.","b":1073.24,"s":1075.83},{"t":"Benim her sözümü dinlerler.","b":1076.18,"s":1078.03},{"t":"Avlularının sonunda tek bir oda vardır.","b":1078.38,"s":1080.95},{"t":"Gider, onları kandırır, bu kadını oraya yatırırım.","b":1081.3,"s":1084.42},{"t":"El ayak kesildikten sonra seni götürür gizlice bu odaya sokarım.","b":1084.77,"s":1088.86}],[{"t":"— Doğru söyle...","b":1089.66,"s":1090.53}],[{"t":"— Sen, hemen altınları ver, yiğidim.","b":1091.33,"s":1093.6}],[{"t":"Durmuş kesesinden beş altını çıkardı.","b":1094.4,"s":1097.06},{"t":"Kocakarıya verdi.","b":1097.41,"s":1098.85},{"t":"Atını onun avlusuna bağladı.","b":1099.2,"s":1101.19},{"t":"Hiddetinden tir tir titriyordu.","b":1101.54,"s":1103.7},{"t":"Gece yarısı geçti.","b":1104.05,"s":1105.38},{"t":"Kocakarı geldi.","b":1105.73,"s":1106.98},{"t":"Onu aldı.","b":1107.33,"s":1108.25},{"t":"Küçük bir bahçe kapısından geçirdi.","b":1108.6,"s":1111.02},{"t":"Bir avlunun en sonundaki tek odaya soktu.","b":1111.37,"s":1114.24},{"t":"Durmuş yüzünü salıyla sarmıştı.","b":1114.59,"s":1116.84},{"t":"Karısı onu tanımadı.","b":1117.19,"s":1118.75},{"t":"Hemen bağırmaya başladı.","b":1119.1,"s":1120.85},{"t":"Durmuş sesini çıkarmadı.","b":1121.2,"s":1123.1},{"t":"Kapıyı kitledi.","b":1123.45,"s":1124.75},{"t":"Üzerine yürüdü.","b":1125.1,"s":1126.23},{"t":"Zavallı kadın köşeye büzülmüş, hem bağırıyor, hem tekme atıyordu.","b":1126.58,"s":1130.69},{"t":"Durmuş'u yanına hiç yaklaştırmadı.","b":1131.04,"s":1133.4},{"t":"Akşamdan uyuyan oğlu yatağın üzerindeydi.","b":1133.75,"s":1136.62},{"t":"Annesinin haykırmasına uyanmadı.","b":1136.97,"s":1139.17},{"t":"Mışıl mışıl uyudu.","b":1139.52,"s":1140.96},{"t":"Durmuş, karısını daha çok bağırtmamak için kapının yanına oturdu.","b":1141.31,"s":1145.31},{"t":"Hiç sesini çıkarmadı.","b":1145.66,"s":1147.21},{"t":"Bütün gece ağlayan kadıncağız sabaha karşı korkudan, yorgunluktan sızar gibi olmuştu.","b":1147.56,"s":1152.88},{"t":"Avluda horozlar öttü.","b":1153.23,"s":1154.93},{"t":"Durmuş yavaşça yatakta uyuyan çocuğunu aldı.","b":1155.28,"s":1158.34},{"t":"Sessizce dışarı çıktı.","b":1158.69,"s":1160.4},{"t":"Avluyu geçti.","b":1160.75,"s":1161.92},{"t":"Atına bindi.","b":1162.27,"s":1163.29},{"t":"Dörtnala köyüne döndü.","b":1163.64,"s":1165.26}],[{"t":"Karısının akrabaları, gece çocuğun çalındığını duyunca, ne yapacaklarını şaşırdılar.","b":1166.06,"s":1171.01},{"t":"\"Ağaya ne cevap vereceğiz?\" diye düşünmeye başladılar.","b":1171.36,"s":1174.93},{"t":"Kocakarı buna da bir çare buldu:","b":1175.28,"s":1177.3}],[{"t":"— Bu oda zaten eski...","b":1178.1,"s":1179.43},{"t":"Yakınız.","b":1179.78,"s":1180.68},{"t":"\"Gece yangın oldu, çocuğu kurtaramadık\" dersiniz, dedi.","b":1181.03,"s":1184.53}],[{"t":"Onu dinlediler.","b":1185.33,"s":1186.56},{"t":"Hemen odayı yaktılar.","b":1186.91,"s":1188.56},{"t":"Ağlayarak, sızlayarak, Durmuş'un karısını evine getirdiler.","b":1188.91,"s":1192.74},{"t":"Hepsinin alnında çatkı vardı.","b":1193.09,"s":1195.3},{"t":"Dövünüp duruyorlardı.","b":1195.65,"s":1197.18}],[{"t":"Durmuş:","b":1197.98,"s":1198.78}],[{"t":"— Çocuk nerede? diye sordu.","b":1199.58,"s":1201.53}],[{"t":"— Ah olan oldu!","b":1202.33,"s":1203.45},{"t":"Gece odamız yandı.","b":1203.8,"s":1205.17},{"t":"Çocuğu kurtaramadık, dediler.","b":1205.52,"s":1207.56}],[{"t":"Durmuş güldü:","b":1208.36,"s":1209.63}],[{"t":"— Neye ağlıyorsunuz canım, dedi.","b":1210.43,"s":1212.28},{"t":"Başımız sağ olsun.","b":1212.63,"s":1214.02},{"t":"Elhamdülillah genciz.","b":1214.37,"s":1216.21},{"t":"Allah başkasını verir.","b":1216.56,"s":1218.14}],[{"t":"Karısının akrabaları, Durmuş'un bu soğukkanlılığından biraz ferahlar gibi oldular.","b":1218.94,"s":1223.58}],[{"t":"Tam bu sırada kapı açıldı.","b":1224.38,"s":1226.24},{"t":"Durmuş'un çocuğu içeri girdi.","b":1226.59,"s":1228.57},{"t":"Annesinin kucağına atıldı.","b":1228.92,"s":1230.77},{"t":"Çocuğun yandığını söyleyenler şaşırdılar.","b":1231.12,"s":1233.81},{"t":"O vakit Durmuş:","b":1234.16,"s":1235.43}],[{"t":"— Gördünüz ya, yalancı alçaklar, niçin karımı kendimin bulunmadığı yere göndermiyormuşum, diye bağırdı.","b":1236.23,"s":1242.22}],[{"t":"Hepsini, tekme tokat, kovdu.","b":1243.02,"s":1245.07},{"t":"Karısına döndü:","b":1245.42,"s":1246.67}],[{"t":"— Eğer gece orada bana el sürseydin hemen seni öldürecektim.","b":1247.47,"s":1251.46},{"t":"İşte ibret al da, sakın bir daha kocandan ayrı bir yere gitmek isteme, dedi.","b":1251.81,"s":1256.69}],[{"t":"İhtiyar efendisine üç senelik emeğinin hakkını da helâl etti.","b":1257.49,"s":1261.61}]]}