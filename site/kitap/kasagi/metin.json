{"baslik":"Kaşağı","yazar":"Ömer Seyfettin","kaynak":"https://tr.wikisource.org/w/index.php?oldid=172873","sure":503.2,"paragraflar":[[{"t":"Ahırın avlusunda oynarken aşağıda, gümüş söğütler altında görünmeyen derenin hazin şırıltısını işitirdik.","b":0.0,"s":6.61},{"t":"Evimiz iç çitin büyük kestane ağaçları arkasında kaybolmuş gibiydi.","b":6.96,"s":11.16},{"t":"Annem, İstanbul'a gittiği için benden bir yaş küçük olan kardeşim Hasan'la artık Dadaruh'un yanından hiç ayrılmıyorduk.","b":11.51,"s":18.88},{"t":"Bu, babamın seyisi, ihtiyar bir adamdı.","b":19.23,"s":21.79},{"t":"Sabahleyin erkenden ahıra koşuyorduk.","b":22.14,"s":24.78},{"t":"En sevdiğimiz şey atlardı.","b":25.13,"s":27.04},{"t":"Dadaruh'la beraber onları suya götürmek, çıplak sırtlarına binmek, ne doyulmaz bir zevkti.","b":27.39,"s":33.06},{"t":"Hasan korkar, yalnız binemezdi.","b":33.41,"s":35.62},{"t":"Dadaruh onu kendi önüne alırdı.","b":35.97,"s":38.23},{"t":"Torbalara arpa koymak, yemliklere ot doldurmak, gübreleri kaldırmak eğlenceli bir oyundan ziyade, bizim hoşumuza gidiyordu.","b":38.58,"s":46.15},{"t":"Hele tımar...","b":46.5,"s":47.29},{"t":"Bu en zevkli şeydi.","b":47.64,"s":49.09},{"t":"Dadaruh eline kaşağıyı alıp işe başladı mı, tıpkı... tık... tık... tık... tıpkı bir saat gibi... yerimde duramaz:","b":49.44,"s":55.66}],[{"t":"— Ben de yapacağım! diye tuttururdum.","b":56.46,"s":58.61}],[{"t":"O vakit Dadaruh, beni Tosun'un sırtına koyar, elime kaşağıyı verir,","b":59.41,"s":63.93}],[{"t":"— Hadi yap! derdi.","b":64.73,"s":66.6}],[{"t":"Bu demir aleti hayvanın üstüne sürter, fakat o uyumlu tıkırtıyı çıkaramazdım.","b":67.4,"s":72.49}],[{"t":"— Kuyruğunu sallıyor mu?","b":73.29,"s":74.53}],[{"t":"— Sallıyor.","b":75.33,"s":76.29}],[{"t":"— Hani bakayım?..","b":77.09,"s":78.1}],[{"t":"Eğilirdim, uzanırdım.","b":78.9,"s":80.38},{"t":"Lakin atın sağrısından kuyruğu görünmezdi.","b":80.73,"s":83.56}],[{"t":"Her sabah ahıra gelir gelmez,","b":84.36,"s":86.51}],[{"t":"— Dadaruh, tımarı ben yapacağım, derdim.","b":87.31,"s":89.8}],[{"t":"— Yapamazsın.","b":90.6,"s":91.62}],[{"t":"— Niçin?","b":92.42,"s":93.07}],[{"t":"— Daha küçüksün de ondan...","b":93.87,"s":95.42}],[{"t":"— Yapacağım.","b":96.22,"s":97.11}],[{"t":"— Büyü de öyle.","b":97.91,"s":99.38}],[{"t":"— Ne vakit?","b":100.18,"s":101.05}],[{"t":"— Boyun at kadar olduğu vakit.","b":101.85,"s":103.94}],[{"t":"At, ahır işlerinde yalnız tımarı beceremiyordum.","b":104.74,"s":107.75},{"t":"Boyum atın karnına bile varmıyordu.","b":108.1,"s":110.43},{"t":"Halbuki en keyifli, en eğlenceli şey buydu.","b":110.78,"s":113.74},{"t":"Sanki kaşağının muntazam tıkırtısı Tosun'un hoşuna gidiyor, kulaklarını kısıyor, kuyruğunu kocaman bir püskül gibi sallıyordu.","b":114.09,"s":121.85},{"t":"Tam tımar biteceğine yakın huysuzlanır, o zaman Dadaruh, \"Höyt..\" diye sağrısına bir tokat indirir, sonra öteki atları tımara başlardı.","b":122.2,"s":130.74},{"t":"Ben bir gün yalnız başıma kaldım.","b":131.09,"s":133.17},{"t":"Hasan'la Dadaruh dere kenarına inmişlerdi.","b":133.52,"s":136.49},{"t":"İçimde bir tımar etmek hırsı uyandı.","b":136.84,"s":139.36},{"t":"Kaşağıyı aradım, bulamadım.","b":139.71,"s":141.43},{"t":"Ahırın köşesinde Dadaruh'un penceresiz küçük bir odası vardı.","b":141.78,"s":145.84},{"t":"Buraya girdim.","b":146.19,"s":147.2},{"t":"Rafları aradım.","b":147.55,"s":148.77},{"t":"Eyerlerin arasına falan baktım.","b":149.12,"s":151.27},{"t":"Yok, yok!","b":151.62,"s":152.59},{"t":"Yatağın altında, yeşil tahtadan bir sandık duruyordu.","b":152.94,"s":156.52},{"t":"Onu açtım.","b":156.87,"s":157.83},{"t":"Az daha sevincimden haykıracaktım.","b":158.18,"s":160.65},{"t":"Annemin bir hafta önce İstanbul'dan gönderdiği hediyeler içinden çıkan fakfon kaşağı, pırıl pırıl parlıyordu.","b":161.0,"s":167.7},{"t":"Hemen kaptım.","b":168.05,"s":169.13},{"t":"Tosun'un yanına koştum.","b":169.48,"s":171.03},{"t":"Karnına sürtmek istedim.","b":171.38,"s":173.11},{"t":"Rahat durmuyordu.","b":173.46,"s":174.72}],[{"t":"— Galiba acıtıyor? dedim.","b":175.52,"s":177.23}],[{"t":"Gümüş gibi parlayan bu güzel kaşağının dişlerine baktım.","b":178.03,"s":181.53},{"t":"Çok keskin, çok sivriydi.","b":181.88,"s":183.7},{"t":"Biraz köreltmek için duvarın taşlarına sürtmeye başladım.","b":184.05,"s":187.59},{"t":"Dişleri bozulunca tekrar tecrübe ettim.","b":187.94,"s":190.6},{"t":"Gene atların hiçbiri durmuyordu.","b":190.95,"s":193.02},{"t":"Kızdım.","b":193.37,"s":193.93},{"t":"Öfkemi sanki kaşağıdan çıkarmak istedim.","b":194.28,"s":197.03},{"t":"On adım ilerdeki çeşmeye koştum.","b":197.38,"s":199.73},{"t":"Kaşağıyı yalağın taşına koydum.","b":200.08,"s":202.1},{"t":"Yerden kaldırabileceğim en ağır bir taş bularak üstüne hızlı hızlı indirmeye başladım.","b":202.45,"s":207.89},{"t":"İstanbul'dan gelen, ihtimal, Dadaruh'un kullanmaya kıyamadığı bu güzel kaşağıyı ezdim, parçaladım.","b":208.24,"s":214.29},{"t":"Sonra yalağın içine attım.","b":214.64,"s":216.46}],[{"t":"Babam, her sabah dışarıya giderken bir kere ahıra uğrar, öteye beriye bakardı.","b":217.26,"s":222.08},{"t":"Ben o gün gene ahırda yalnızdım.","b":222.43,"s":224.59},{"t":"Hasan evde hizmetçimiz Pervin'le kalmıştı.","b":224.94,"s":227.84},{"t":"Babam çeşmeye bakarken, yalağın içinde kırılmış kaşağıyı gördü; Dadaruh'a haykırdı:","b":228.19,"s":233.51}],[{"t":"— Gel buraya!","b":234.31,"s":235.22}],[{"t":"Nefesim kesilecekti, bilmem neden, çok korkmuştum.","b":236.02,"s":239.43},{"t":"Dadaruh şaşırdı, kırılmış kaşağı meydana çıkınca, babam bunu kimin yaptığını sordu.","b":239.78,"s":244.82},{"t":"Dadaruh:","b":245.17,"s":245.94}],[{"t":"— Bilmiyorum, dedi.","b":246.74,"s":247.99}],[{"t":"Babamın gözleri bana döndü, daha bir şey sormadan:","b":248.79,"s":251.88}],[{"t":"— Hasan dedim.","b":252.68,"s":253.67}],[{"t":"— Hasan mı?","b":254.47,"s":255.29}],[{"t":"— Evet, dün Dadaruh uyurken odaya girdi.","b":256.09,"s":258.86},{"t":"Sandıktan aldı.","b":259.21,"s":260.6},{"t":"Sonra yalağın taşında ezdi.","b":260.95,"s":262.98}],[{"t":"— Niye Dadaruh'a haber vermedin?","b":263.78,"s":265.55}],[{"t":"— Uyuyordu.","b":266.35,"s":267.22}],[{"t":"— Çağır şunu bakayım.","b":268.02,"s":269.32}],[{"t":"Çitin kapısından geçtim.","b":270.12,"s":271.85},{"t":"Gölgeli yoldan eve doğru koştum.","b":272.2,"s":274.48},{"t":"Hasan'ı çağırdım.","b":274.83,"s":275.98},{"t":"Zavallının bir şeyden haberi yoktu.","b":276.33,"s":278.67},{"t":"Koşarak arkamdan geldi.","b":279.02,"s":280.91},{"t":"Babam pek sertti.","b":281.26,"s":282.61},{"t":"Bir bakışından ödümüz kopardı.","b":282.96,"s":285.04},{"t":"Hasan'a dedi ki:","b":285.39,"s":286.73}],[{"t":"— Eğer yalan söylersen seni döverim!","b":287.53,"s":289.88}],[{"t":"— Söylemem.","b":290.68,"s":291.57}],[{"t":"— Pekala, bu kaşağıyı niye kırdın?","b":292.37,"s":294.35}],[{"t":"Hasan, Dadaruh'un elinde duran alete şaşkın şaşkın baktı!","b":295.15,"s":299.03},{"t":"Sonra sarı saçlı başını sarsarak:","b":299.38,"s":301.72}],[{"t":"— Ben kırmadım, dedi.","b":302.52,"s":303.78}],[{"t":"— Yalan söyleme, diyorum.","b":304.58,"s":306.0}],[{"t":"— Ben kırmadım.","b":306.8,"s":307.74}],[{"t":"Babam tekrar:","b":308.54,"s":309.7}],[{"t":"— Doğru söyle, darılmayacağım.","b":310.5,"s":312.28},{"t":"Yalan çok fenadır, dedi.","b":312.63,"s":314.39}],[{"t":"Hasan, inkârında inat etti.","b":315.19,"s":317.37},{"t":"Babam hiddetlendi.","b":317.72,"s":319.07},{"t":"Üzerine yürüdü, \"Utanmaz yalancı\" diye yüzüne bir tokat indirdi.","b":319.42,"s":323.53}],[{"t":"— Götür bunu eve; sakın bunu bir daha buraya sokma.","b":324.33,"s":327.53},{"t":"Hep Pervin'le otursun! diye haykırdı.","b":327.88,"s":330.55}],[{"t":"Dadaruh, ağlayan kardeşimi kucağına aldı.","b":331.35,"s":334.21},{"t":"Çitin kapısına doğru yürüdü.","b":334.56,"s":336.42},{"t":"Artık ahırda hep yalnız oynuyordum.","b":336.77,"s":338.98},{"t":"Hasan evde mahpustu.","b":339.33,"s":341.02},{"t":"Annem geldikten sonra da affedilmedi.","b":341.37,"s":344.07},{"t":"Fırsat düştükçe, \"O yalancı\" derdi babam.","b":344.42,"s":347.09},{"t":"Hasan yediği tokat aklına geldikçe ağlamaya başlar, güç susardı.","b":347.44,"s":351.93},{"t":"Zavallı anneciğim benim iftira atabileceğime hiç ihtimal vermiyordu.","b":352.28,"s":356.86},{"t":"\"Aptal Dadaruh, atlara ezdirmiş olmasın?\" derdi.","b":357.21,"s":360.58}],[{"t":"Ertesi sene annem, yazın gene İstanbul'a gitti.","b":361.38,"s":364.57},{"t":"Biz yalnız kaldık.","b":364.92,"s":366.36},{"t":"Hasan'a ahır hâlâ yasaktı.","b":366.71,"s":368.55},{"t":"Geceleri yatakta atların ne yaptıklarını, tayların büyüyüp büyümediğini bana sorardı.","b":368.9,"s":373.71},{"t":"Bir gün birdenbire hastalandı.","b":374.06,"s":376.06},{"t":"Kasabaya at gönderildi.","b":376.41,"s":378.1},{"t":"Doktor geldi.","b":378.45,"s":379.63},{"t":"\"Kuşpalazı\" dedi.","b":379.98,"s":381.59},{"t":"Çiftlikteki köylü kadınlar eve üşüştüler.","b":381.94,"s":384.71},{"t":"Birtakım kuşlar getiriyorlar, kesip kardeşimin boynuna sarıyorlardı.","b":385.06,"s":389.48},{"t":"Babam yatağın başucundan hiç ayrılmıyordu.","b":389.83,"s":392.65}],[{"t":"Dadaruh çok durgundu.","b":393.45,"s":395.06},{"t":"Pervin hüngür hüngür ağlıyordu.","b":395.41,"s":397.58}],[{"t":"— Niye ağlıyorsun? diye sordum.","b":398.38,"s":400.3}],[{"t":"— Kardeşin hasta.","b":401.1,"s":402.76}],[{"t":"— İyi olacak.","b":403.56,"s":404.57}],[{"t":"— İyi olmayacak.","b":405.37,"s":406.49}],[{"t":"— Ya ne olacak?","b":407.29,"s":408.5}],[{"t":"— Kardeşin ölecek! dedi.","b":409.3,"s":411.45}],[{"t":"— Ölecek mi?","b":412.25,"s":413.19}],[{"t":"Ben de ağlamaya başladım.","b":413.99,"s":415.79},{"t":"O hastalandığından beri Pervin'in yanında yatıyordum.","b":416.14,"s":419.19},{"t":"O gece hiç uyuyamadım.","b":419.54,"s":421.17},{"t":"Dalar dalmaz, Hasan'ın hayali gözümün önüne geliyor, \"İftiracı!","b":421.52,"s":425.66},{"t":"İftiracı!\" diye karşımda ağlıyordu.","b":426.01,"s":428.61}],[{"t":"Pervin'i uyandırdım.","b":429.41,"s":430.77}],[{"t":"— Ben Hasan'ın yanına gideceğim, dedim.","b":431.57,"s":433.78}],[{"t":"— Niçin?","b":434.58,"s":435.19}],[{"t":"— Babama bir şey söyleyeceğim.","b":435.99,"s":437.89}],[{"t":"— Ne söyleyeceksin?","b":438.69,"s":440.01}],[{"t":"— Kaşağıyı ben kırmıştım, onu söyleyeceğim.","b":440.81,"s":443.54}],[{"t":"— Hangi kaşağıyı?","b":444.34,"s":445.46}],[{"t":"— Geçen seneki.","b":446.26,"s":447.58},{"t":"Hani babamın Hasan'a darıldığını...","b":447.93,"s":449.76}],[{"t":"Lafımı tamamlayamadım.","b":450.56,"s":452.2},{"t":"Derin hıçkırıklar içinde boğuluyordum.","b":452.55,"s":454.9},{"t":"Ağlaya ağlaya Pervin'e anlattım.","b":455.25,"s":457.45},{"t":"Şimdi babama söylersem, Hasan da duyacak belki beni affedecekti.","b":457.8,"s":462.26}],[{"t":"— Yarın söylersin, dedi.","b":463.06,"s":465.15}],[{"t":"— Hayır, şimdi gideceğim.","b":465.95,"s":467.54}],[{"t":"— Şimdi baban uyuyor, yarın sabah söylersin.","b":468.34,"s":471.27},{"t":"Hasan da uyuyor.","b":471.62,"s":472.87},{"t":"Onu öpersin, ağlarsın, seni affeder.","b":473.22,"s":475.9}],[{"t":"— Pekala!","b":476.7,"s":477.5}],[{"t":"— Haydi şimdi uyu!","b":478.3,"s":479.61}],[{"t":"Sabaha kadar gene gözlerimi kapayamadım.","b":480.41,"s":482.85},{"t":"Hava henüz ağarırken Pervin'i uyandırdım.","b":483.2,"s":485.79},{"t":"Kalktım.","b":486.14,"s":486.95},{"t":"Ben içimdeki zehirden vicdan azabını boşaltmak için acele ediyordum.","b":487.3,"s":492.01},{"t":"Yazık ki, zavallı masum kardeşim, o gece ölmüştü.","b":492.36,"s":495.79},{"t":"Sofada çiftlik imamıyla Dadaruh'u ağlarken gördük.","b":496.14,"s":499.47},{"t":"Babamın dışarıya çıkmasını bekliyorlardı.","b":499.82,"s":502.39}]]}